{
  "manifestVersion": 1,
  "id": "azure-devops-achievements-dev",
  "name": "Achievements (Dev)",
  "version": "0.0.2",
  "publisher": "jerone",
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "description": "Dev version — loads from localhost:3000",
  "categories": ["Azure Boards"],
  "icons": { "default": "images/logo.png" },
  "scopes": [
    "vso.build",
    "vso.code",
    "vso.work",
    "vso.test",
    "vso.profile",
    "vso.project"
  ],
  "contributions": [
    {
      "id": "achievements-hub",
      "type": "ms.vss-web.hub",
      "description": "Earn achievements and view your team leaderboard",
      "targets": ["ms.vss-web.home-hub-group"],
      "properties": {
        "name": "Achievements (Dev)",
        "order": 100,
        "uri": "https://localhost:3000/hub.html"
      }
    }
  ],
  "files": [
    { "path": "images", "addressable": true }
  ]
}
